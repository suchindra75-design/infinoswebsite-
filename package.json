{
  "name": "infinos-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "model:build": "sh -c '${BLENDER:-blender} --background --factory-startup --python tools/build_infinos_bag.py -- --out tools/build/t1.glb && node tools/optimize_glb.mjs tools/build/t1.glb public/models/t1.glb'",
    "sequences:render": "sh -c '${BLENDER:-blender} --background --factory-startup --python tools/render_sequences.py -- --skip-existing'",
    "sequences:encode": "python3 tools/encode_sequences.py",
    "launch-check": "node scripts/launch-check.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.2",
    "gsap": "^3.12.7",
    "lenis": "^1.1.20",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.175.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.175.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "^5.8.2"
  }
}
